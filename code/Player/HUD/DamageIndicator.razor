@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits PanelComponent

@* Radial damage direction indicator — red arrow on screen pointing toward attacker.
   CS2 / Source style: appears on hit, fades out over DamageFadeTime seconds.
   Each indicator is a CSS-positioned div rotated to point at the attacker. *@

@foreach ( var ind in _indicators )
{
	float alpha = 1f - (ind.Since / DamageFadeTime);
	float angleDeg = ComputeAngleDeg( ind.WorldPos );
	<div class="damage-arrow" style="transform: rotate(@(angleDeg)deg); opacity: @(alpha.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));"></div>
}

@code
{
	const float DamageFadeTime   = 2.0f;
	const float RadialDistancePx = 120f;
	const float ArrowSize        = 48f;

	global::Player LocalPlayer => global::Player.FindLocalPlayer();

	readonly List<(Vector3 WorldPos, TimeSince Since)> _indicators = new();

	public void AddIndicator( Vector3 attackerWorldPos )
	{
		_indicators.Add( (attackerWorldPos, new TimeSince()) );
		StateHasChanged();
	}

	float ComputeAngleDeg( Vector3 worldPos )
	{
		var player = LocalPlayer;
		if ( !player.IsValid() ) return 0f;
		var eyePos = player.EyeTransform.Position;
		var eyeRot = player.EyeTransform.Rotation;
		var focal  = eyePos + eyeRot.Forward * 24f;
		var dir    = (worldPos - focal).Normal;
		float angle = -MathF.Atan2( dir.y, dir.x )
		              + eyeRot.Angles().yaw.DegreeToRadian()
		              - MathF.PI / 2f;
		return angle.RadianToDegree();
	}

	protected override void OnUpdate()
	{
		// Prune expired indicators and trigger re-render if anything changed
		int before = _indicators.Count;
		for ( int i = _indicators.Count - 1; i >= 0; i-- )
			if ( _indicators[i].Since >= DamageFadeTime )
				_indicators.RemoveAt( i );
		if ( _indicators.Count != before || _indicators.Count > 0 )
			StateHasChanged();
	}

	protected override int BuildHash() => _indicators.Count;
}
